# ─── Database Configuration ─────────────────────────────────────────────────
#
# Option 1: Self-hosted (VPS) with SQLite
# DATABASE_URL=file:./db/custom.db
#
# Option 2: Vercel / Serverless with Neon PostgreSQL
# 1. Create a free database at https://neon.tech
# 2. Copy the connection string below
# DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# Option 3: Vercel Postgres
# 1. Add Vercel Postgres storage in your project dashboard
# 2. The POSTGRES_URL will be auto-configured
# DATABASE_URL=postgresql://default:xxxxx@ep-xxx.us-east-1.aws.neon.tech/verceldb?sslmode=require
#
DATABASE_URL=file:./db/custom.db
