# Database — SQLite for self-hosted, or use a cloud DB for Vercel
DATABASE_URL=file:./db/custom.db

# ─── Hybrid Deployment (GitHub Actions) ─────────────────────────────────────
# Set these to enable GitHub Actions hybrid scanning mode.
# Scanners run on Ubuntu runners, results post back via callback.

# GitHub Personal Access Token with `repo` scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub repository in "owner/repo" format
# The repo must contain the .github/workflows/vulnscan.yml workflow
GITHUB_REPO=

# Public URL where GitHub Actions can post results back
# For Vercel: https://your-app.vercel.app
# For local dev: use a tunnel like ngrok (https://xxx.ngrok.io)
CALLBACK_URL=

# Shared secret for callback authentication (auto-generated if not set)
CALLBACK_SECRET=

# ─── Scanner Configuration (Local Mode) ──────────────────────────────────────
# Custom PATH for scanner binaries
# HOME=/root

# Nuclei templates directory (default: $HOME/nuclei-templates)
# NUCLEI_TEMPLATES_DIR=/root/nuclei-templates

# Go binary path (for nuclei installed via `go install`)
# GOPATH=/root/go
