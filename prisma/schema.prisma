generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Scan {
  id        String   @id @default(uuid())
  target    String
  scanType  String   @default("nmap")
  status    String   @default("Pending")
  results   String?
  mode      String   @default("local")  // "local" or "hybrid" (GitHub Actions)
  githubRunId String?  // GitHub Actions run ID (hybrid mode)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id          String   @id @default(uuid())
  target      String
  scanType    String   @default("nmap")
  port        String   @default("80")
  frequency   String   // hourly | daily | weekly | monthly
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
